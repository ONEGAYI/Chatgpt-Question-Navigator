{
  "name": "chatgpt-question-navigator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:chrome": "wxt -b chrome",
    "dev:edge": "wxt -b edge",
    "dev:edge:isolated": "node scripts/dev-edge-isolated.mjs",
    "build": "wxt build && node scripts/copy-build.mjs",
    "build:chrome": "wxt build -b chrome && node scripts/copy-build.mjs",
    "build:edge": "wxt build -b edge && node scripts/copy-build.mjs",
    "compile": "tsc --noEmit",
    "test:order": "node --test scripts/order-list-regression.test.mjs",
    "bump": "node scripts/bump.mjs",
    "release": "node scripts/release.mjs",
    "zip": "wxt zip"
  },
  "dependencies": {
    "@preact/preset-vite": "^2.10.2",
    "preact": "^10.26.9"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "typescript": "^5.8.3",
    "wxt": "^0.20.6"
  }
}
